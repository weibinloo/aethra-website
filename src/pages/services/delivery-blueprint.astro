---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title="Delivery Blueprint | Aethra"
  description="Aethra translates data and AI strategy into phased delivery plans, capability models, and measurable outcomes."
>
  <section class="hero container section">
    <p class="eyebrow reveal">Delivery Blueprint</p>
    <h1 class="reveal">Turn strategy into phased, measurable execution.</h1>
    <p class="hero-copy reveal">
      Translate your data and AI strategy into clear delivery plans with
      capability models, milestones, and measurable outcomes.
    </p>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">The challenge</p>
      <h2>Strategy without execution is shelf-ware</h2>
    </div>
    <div class="service-content reveal">
      <p>
        A great strategy means nothing if it can't be delivered. Many
        organisations invest in data and AI strategies that end up as
        PowerPoint decks — never translated into actionable plans with clear
        ownership and timelines.
      </p>
      <p>
        The Delivery Blueprint bridges strategy and execution. We take your
        strategic objectives and design the operating model, team structures,
        and phased delivery plan needed to make them real.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">What we deliver</p>
      <h2>Execution-ready outputs</h2>
    </div>
    <div class="grid services-grid">
      <article class="card reveal">
        <h3>Delivery Roadmap</h3>
        <p>A phased plan with clear milestones, dependencies, and success criteria for each initiative.</p>
      </article>
      <article class="card reveal">
        <h3>Capability Model</h3>
        <p>Team structures, skill requirements, and resourcing plans to support delivery at each phase.</p>
      </article>
      <article class="card reveal">
        <h3>Governance & KPIs</h3>
        <p>Measurement frameworks and governance structures to track progress and sustain momentum.</p>
      </article>
    </div>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">How it works</p>
      <h2>From plan to momentum</h2>
    </div>
    <div class="timeline">
      <article class="timeline-item reveal">
        <span class="step">01</span>
        <h3>Scope</h3>
        <p>We review your strategy and assess current delivery capabilities, gaps, and constraints.</p>
      </article>
      <article class="timeline-item reveal">
        <span class="step">02</span>
        <h3>Structure</h3>
        <p>We design the operating model, team structures, and phased delivery plan.</p>
      </article>
      <article class="timeline-item reveal">
        <span class="step">03</span>
        <h3>Support</h3>
        <p>We provide hands-on guidance through early execution to build momentum and confidence.</p>
      </article>
    </div>
  </section>

  <section class="container section">
    <div class="cta reveal">
      <p class="eyebrow">Get started</p>
      <h2>Ready to turn strategy into execution?</h2>
      <p>Book a discovery call and we'll help you build a delivery plan that sticks.</p>
      <a class="btn btn-primary" href={withBase('/contact')}>Book discovery call</a>
    </div>
  </section>
</BaseLayout>

<style>
  .service-content {
    max-width: 68ch;
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .service-content p {
    color: var(--text-muted);
    font-size: 1.06rem;
    line-height: 1.7;
  }
</style>
