---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
---

<BaseLayout
  title="AI Opportunity Mapping | Aethra"
  description="Aethra identifies high-value AI use cases with clear feasibility, ROI, and implementation pathways for your business."
>
  <section class="hero container section">
    <p class="eyebrow reveal">AI Opportunity Mapping</p>
    <h1 class="reveal">Find the AI use cases that actually matter.</h1>
    <p class="hero-copy reveal">
      Identify high-value AI opportunities with clear feasibility, ROI, and
      implementation pathways — so you invest in what works, not what's trending.
    </p>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">The challenge</p>
      <h2>AI hype vs. AI value</h2>
    </div>
    <div class="service-content reveal">
      <p>
        The AI landscape is overwhelming. Every vendor promises transformation,
        but most businesses struggle to identify which use cases will actually
        deliver ROI given their data, systems, and team capabilities.
      </p>
      <p>
        AI opportunity mapping cuts through the noise. We systematically evaluate
        your business processes to find the use cases where AI can create
        measurable, achievable impact.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">What we deliver</p>
      <h2>Clarity on where AI fits</h2>
    </div>
    <div class="grid services-grid">
      <article class="card reveal">
        <h3>Use Case Portfolio</h3>
        <p>A prioritised catalogue of AI opportunities mapped to business processes and outcomes.</p>
      </article>
      <article class="card reveal">
        <h3>Feasibility Assessment</h3>
        <p>Each use case evaluated for data readiness, technical complexity, and organisational fit.</p>
      </article>
      <article class="card reveal">
        <h3>ROI Framework</h3>
        <p>Expected value, investment requirements, and time-to-impact for each opportunity.</p>
      </article>
    </div>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">How it works</p>
      <h2>Structured, not speculative</h2>
    </div>
    <div class="timeline">
      <article class="timeline-item reveal">
        <span class="step">01</span>
        <h3>Map</h3>
        <p>We map your business processes, data assets, and existing technology to identify candidates.</p>
      </article>
      <article class="timeline-item reveal">
        <span class="step">02</span>
        <h3>Evaluate</h3>
        <p>Each candidate is scored on feasibility, value, risk, and alignment with business goals.</p>
      </article>
      <article class="timeline-item reveal">
        <span class="step">03</span>
        <h3>Recommend</h3>
        <p>We deliver a prioritised roadmap of AI initiatives with clear next steps and resource needs.</p>
      </article>
    </div>
  </section>

  <section class="container section">
    <div class="cta reveal">
      <p class="eyebrow">Get started</p>
      <h2>Ready to find your highest-value AI opportunities?</h2>
      <p>Book a discovery call and we'll help you separate signal from noise.</p>
      <a class="btn btn-primary" href={withBase('/contact')}>Book discovery call</a>
    </div>
  </section>
</BaseLayout>

<style>
  .service-content {
    max-width: 68ch;
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .service-content p {
    color: var(--text-muted);
    font-size: 1.06rem;
    line-height: 1.7;
  }
</style>
