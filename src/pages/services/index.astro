---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { withBase } from '../../lib/paths';

const iconDatabase = '<svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v6c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 11v6c0 1.66 4.03 3 9 3s9-1.34 9-3v-6"/></svg>';
const iconLightbulb = '<svg viewBox="0 0 24 24"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/></svg>';
const iconRocket = '<svg viewBox="0 0 24 24"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11.5L12 15z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>';
---

<BaseLayout
  title="Services | Aethra"
  description="Aethra delivers data strategy, AI opportunity mapping, and delivery blueprints to help businesses turn data intelligence into measurable outcomes."
>
  <section class="hero container section">
    <p class="eyebrow reveal">Our services</p>
    <h1 class="reveal">Strategy that lands in real operations.</h1>
    <p class="hero-copy reveal">
      We help businesses move from data ambition to data execution through three
      core service areas — each designed to deliver clarity, confidence, and
      measurable outcomes.
    </p>
  </section>

  <section class="container section">
    <div class="grid services-grid">
      <Card
        title="Data Strategy"
        description="Define the architecture, governance, and prioritised initiatives that make data a trusted growth asset."
        href="/services/data-strategy"
        icon={iconDatabase}
      />
      <Card
        title="AI Opportunity Mapping"
        description="Identify high-value AI use cases with clear feasibility, ROI, and implementation pathways."
        href="/services/ai-opportunity-mapping"
        icon={iconLightbulb}
      />
      <Card
        title="Delivery Blueprint"
        description="Translate strategy into phased delivery plans, capability models, and measurable outcomes."
        href="/services/delivery-blueprint"
        icon={iconRocket}
      />
    </div>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">Who we work with</p>
      <h2>Built for growing businesses</h2>
    </div>
    <div class="audience-content reveal">
      <p>
        Our services are designed for small to medium businesses that know data
        and AI can drive growth — but need a clear, practical roadmap to get
        there. Whether you're building your first data capability or scaling
        existing initiatives, we meet you where you are.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="cta reveal">
      <p class="eyebrow">Ready to start?</p>
      <h2>Let's find the right path for your business.</h2>
      <p>
        Book a discovery call to explore how Aethra can help you turn data and
        AI into a competitive advantage.
      </p>
      <a class="btn btn-primary" href={withBase('/contact')}>Book discovery call</a>
    </div>
  </section>
</BaseLayout>

<style>
  .audience-content {
    max-width: 68ch;
    margin-top: 1.5rem;
  }

  .audience-content p {
    color: var(--text-muted);
    font-size: 1.06rem;
    line-height: 1.7;
  }
</style>
