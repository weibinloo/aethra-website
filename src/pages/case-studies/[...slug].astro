---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<BaseLayout
  title={`${study.data.title} | Aethra`}
  description={study.data.summary}
>
  <section class="hero container section">
    <a class="back-link reveal" href={withBase('/case-studies')}>&larr; All case studies</a>
    <span class="industry-tag reveal">{study.data.industry}</span>
    <h1 class="reveal">{study.data.title}</h1>
    <p class="hero-copy reveal">{study.data.summary}</p>
  </section>

  <section class="container section study-content">
    <div class="outcome-banner reveal">
      <span class="outcome-label">Key outcome</span>
      <p class="outcome-text">{study.data.outcome}</p>
    </div>
    <article class="prose reveal">
      <Content />
    </article>
  </section>

  <section class="container section">
    <div class="cta reveal">
      <p class="eyebrow">Ready for similar results?</p>
      <h2>Let's discuss your challenge.</h2>
      <p>Book a discovery call and explore how Aethra can help your business.</p>
      <a class="btn btn-primary" href={withBase('/contact')}>Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.25s ease;
    margin-bottom: 1rem;
    display: inline-block;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .industry-tag {
    display: inline-block;
    width: max-content;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px solid rgba(95, 210, 255, 0.3);
    background: rgba(95, 210, 255, 0.08);
    margin-bottom: 0.5rem;
  }

  .outcome-banner {
    padding: 1.2rem 1.4rem;
    border-radius: var(--radius);
    background: rgba(87, 240, 192, 0.06);
    border: 1px solid rgba(87, 240, 192, 0.2);
    margin-bottom: 2.5rem;
  }

  .outcome-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-2);
  }

  .outcome-text {
    margin-top: 0.4rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
  }

  .prose {
    max-width: 68ch;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0.8rem;
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: 1.8rem;
    margin-bottom: 0.6rem;
  }

  .prose :global(p) {
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    color: var(--text-muted);
    padding-left: 1.4rem;
    margin-bottom: 1rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.65;
  }
</style>
