---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';

const caseStudies = (await getCollection('case-studies')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Case Studies | Aethra"
  description="See how Aethra has helped businesses build practical data and AI strategies that deliver measurable results."
>
  <section class="hero container section">
    <p class="eyebrow reveal">Case Studies</p>
    <h1 class="reveal">Real strategies, real outcomes.</h1>
    <p class="hero-copy reveal">
      See how we've helped businesses turn data and AI ambition into measurable
      results.
    </p>
  </section>

  <section class="container section">
    <div class="grid services-grid">
      {caseStudies.map((study) => (
        <article class="card reveal case-study-card">
          <span class="industry-tag">{study.data.industry}</span>
          <h3>{study.data.title}</h3>
          <p>{study.data.summary}</p>
          <div class="outcome">
            <span class="outcome-label">Outcome</span>
            <p class="outcome-text">{study.data.outcome}</p>
          </div>
          <a class="card-link" href={withBase(`/case-studies/${study.id}`)}>Read full story &rarr;</a>
        </article>
      ))}
    </div>
  </section>

  <section class="container section">
    <div class="cta reveal">
      <p class="eyebrow">Your story next?</p>
      <h2>Let's build something worth writing about.</h2>
      <p>
        Every case study starts with a conversation. Tell us about your
        challenge and we'll explore how we can help.
      </p>
      <a class="btn btn-primary" href={withBase('/contact')}>Start a conversation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .case-study-card {
    gap: 1rem;
  }

  .industry-tag {
    width: max-content;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px solid rgba(95, 210, 255, 0.3);
    background: rgba(95, 210, 255, 0.08);
  }

  .outcome {
    padding: 0.8rem;
    border-radius: 10px;
    background: rgba(87, 240, 192, 0.06);
    border: 1px solid rgba(87, 240, 192, 0.2);
  }

  .outcome-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-2);
  }

  .outcome-text {
    margin-top: 0.3rem;
    font-size: 0.92rem;
    color: var(--text) !important;
    font-weight: 500;
  }

  .card-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition: color 0.25s ease;
  }

  .card-link:hover {
    color: var(--accent-2);
  }
</style>
