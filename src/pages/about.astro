---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="About | Aethra"
  description="Aethra is a data and AI consulting firm that helps small to medium businesses build practical strategies and deliver measurable results."
>
  <section class="hero container section">
    <p class="eyebrow reveal">About Aethra</p>
    <h1 class="reveal">Practical data and AI strategy for growing businesses.</h1>
    <p class="hero-copy reveal">
      We believe every business — not just enterprises — deserves access to
      clear, actionable data and AI strategy. Aethra was founded to bridge the
      gap between ambition and execution.
    </p>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">Our mission</p>
      <h2>Making data intelligence accessible</h2>
    </div>
    <div class="about-content reveal">
      <p>
        Too many businesses know they need to do more with data and AI, but
        don't know where to start — or have been burned by initiatives that
        didn't deliver. Aethra exists to change that.
      </p>
      <p>
        We partner with small to medium businesses to cut through the noise,
        identify the highest-value opportunities, and build strategies that
        actually get implemented. No bloated roadmaps. No theoretical frameworks.
        Just practical, phased plans that move the needle.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">Why Aethra</p>
      <h2>What sets us apart</h2>
    </div>
    <div class="grid services-grid">
      <article class="card reveal">
        <div class="card-icon"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <h3>SMB-focused</h3>
        <p>
          We understand the resource constraints and pace of growing businesses.
          Our strategies are right-sized, not over-engineered.
        </p>
      </article>
      <article class="card reveal">
        <div class="card-icon"><svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
        <h3>Execution-first</h3>
        <p>
          Strategy without delivery is just a document. We design for
          implementation from day one, with clear ownership and milestones.
        </p>
      </article>
      <article class="card reveal">
        <div class="card-icon"><svg viewBox="0 0 24 24"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg></div>
        <h3>Outcome-driven</h3>
        <p>
          Every recommendation is tied to measurable business impact — revenue
          growth, cost reduction, or operational efficiency.
        </p>
      </article>
    </div>
  </section>

  <section class="container section">
    <div class="section-head reveal">
      <p class="eyebrow">Leadership</p>
      <h2>Meet the team</h2>
    </div>
    <div class="team-grid reveal">
      <div class="team-member">
        <div class="team-avatar"></div>
        <h3>Founder Name</h3>
        <p class="team-role">Founder & Principal Consultant</p>
        <p class="team-bio">
          With over a decade of experience in data strategy and AI
          implementation across multiple industries, our founder brings deep
          expertise in translating complex technology into practical business
          outcomes.
        </p>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="cta reveal">
      <p class="eyebrow">Work with us</p>
      <h2>Let's talk about your data and AI ambitions.</h2>
      <p>
        Whether you're just getting started or ready to scale, we'll help you
        find the right path forward.
      </p>
      <a class="btn btn-primary" href={withBase('/contact')}>Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-content {
    max-width: 68ch;
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .about-content p {
    color: var(--text-muted);
    font-size: 1.06rem;
    line-height: 1.7;
  }

  .team-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .team-member {
    display: grid;
    gap: 0.6rem;
  }

  .team-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(95, 210, 255, 0.3), rgba(87, 240, 192, 0.15));
    border: 1px solid var(--surface-border);
  }

  .team-role {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .team-bio {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 48ch;
  }
</style>
