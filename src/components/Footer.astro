---
import { withBase } from '../lib/paths';

const year = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="logo" href={withBase('/')} aria-label="Aethra home">
        <img class="logo-img" src={withBase('/assets/aethra-logo-light.png')} alt="" width="58" height="40" />
        <span class="logo-text">AETHRA</span>
      </a>
      <p class="footer-tagline">Data & AI strategy for growing businesses.</p>
    </div>

    <div class="footer-nav">
      <p class="footer-heading">Navigate</p>
      <ul>
        {navLinks.map(({ href, label }) => (
          <li><a href={withBase(href)}>{label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-contact">
      <p class="footer-heading">Get in touch</p>
      <a class="footer-email" href={withBase('/contact')}>Use the contact form</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} Aethra. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 2rem;
  }

  .footer-brand {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .footer-tagline {
    color: var(--text-muted);
    font-size: 0.9rem;
    max-width: 28ch;
  }

  .footer-heading {
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text);
    margin-bottom: 0.8rem;
  }

  .footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer-nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.25s ease;
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  .footer-contact {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .footer-email {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: color 0.25s ease;
  }

  .footer-email:hover {
    color: var(--accent-2);
  }

  .footer-bottom {
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
