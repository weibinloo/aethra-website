---
import { withBase } from '../lib/paths';
---

<header class="site-header">
  <nav class="container nav">
    <a class="logo" href={withBase('/')} aria-label="Aethra home">
      <img class="logo-img" src={withBase('/assets/aethra-logo-light.png')} alt="" width="58" height="40" />
      <span class="logo-text">AETHRA</span>
    </a>

    <div class="nav-links">
      <a class="btn btn-primary btn-nav" href={withBase('/contact')}>Get in touch</a>
    </div>
  </nav>
</header>

<style>
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .btn-nav {
    font-size: 0.88rem;
    padding: 0.6rem 1.1rem;
  }

  @media (max-width: 768px) {
    .nav-links {
      gap: 1rem;
    }

    .btn-nav {
      font-size: 0.84rem;
      padding: 0.58rem 0.95rem;
    }
  }
</style>
